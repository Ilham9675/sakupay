# Copy to .env (never commit .env). Values here are for local development only.
DB_USERNAME=sakupay
DB_PASSWORD=change-me-local-only
DB_PORT=5432
APP_PORT=8080

# Signs access tokens (HS256). At least 32 bytes; generate one with: openssl rand -base64 48
JWT_SECRET=local-dev-only-replace-with-openssl-rand-base64-48

# Shared with the partner bank to sign top-up webhooks (HMAC-SHA256). At least 32 bytes
TOPUP_WEBHOOK_SECRET=local-dev-only-webhook-secret-change-me

# Optional: creates the first ADMIN on startup (password at least 12 characters)
ADMIN_EMAIL=admin@sakupay.local
ADMIN_PASSWORD=local-admin-password-123
